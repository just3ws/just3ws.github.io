  {% for pos_id in site.data.resume.timeline.history %}
    {% assign pos = site.data.resume.positions[pos_id] %}
    {% if pos and pos.title %}
      {% assign comp_name = pos.company.name | default: pos.company %}
      {% assign title_str = comp_name | append: " — " | append: pos.title %}
      {% assign kw_str = "position experience " | append: comp_name | append: " " | append: pos.title | append: " " | append: pos.dates | append: " " | append: pos.summary | append: " " | append: pos.skills | join: " " %}
      {
        "title": {{ title_str | jsonify }},
        "url": "/resume/positions/{{ pos_id }}/",
        "badge": {{ pos.dates | default: "Position" | jsonify }},
        "icon": "🏢",
        "keywords": {{ kw_str | jsonify }}
      },
    {% endif %}
  {% endfor %}
  {% for interview in site.data.interviews.items %}
    {% assign interviewees_str = interview.interviewees | join: ", " %}
    {% assign title_str = interview.title | default: interviewees_str %}
    {% assign conf_badge = interview.conference | default: "Interview" %}
    {% if interview.conference_year %}
      {% assign conf_badge = conf_badge | append: " " | append: interview.conference_year %}
    {% endif %}
    {% assign kw_str = "interview oral history ugtastic whois tech community " | append: interview.title | append: " " | append: interviewees_str | append: " " | append: interview.topic | append: " " | append: interview.conference | append: " " | append: interview.community | append: " " | append: interview.tags | join: " " %}
    {
      "title": {{ title_str | jsonify }},
      "url": "/interviews/{{ interview.id }}/",
      "badge": {{ conf_badge | jsonify }},
      "icon": "🎙️",
      "keywords": {{ kw_str | jsonify }}
    },
  {% endfor %}
  {% for video in site.data.video_assets.items %}
    {% assign title_str = video.title | default: video.id %}
    {% assign kw_str = "video transcript one-off archive " | append: video.title | append: " " | append: video.topic | append: " " | append: video.tags | join: " " %}
    {
      "title": {{ title_str | jsonify }},
      "url": "/videos/{{ video.id }}/",
      "badge": "Video",
      "icon": "🎥",
      "keywords": {{ kw_str | jsonify }}
    }{% if forloop.last == false %},{% endif %}
  {% endfor %}
  ,
  {% for interviewee in site.data.interviewees_index.items %}
    {% assign title_str = "Speaker: " | append: interviewee.name %}
    {% assign kw_str = "speaker interviewee oral history ugtastic whois tech community " | append: interviewee.name | append: " " | append: interviewee.profile_summary %}
    {
      "title": {{ title_str | jsonify }},
      "url": "/speakers/?q={{ interviewee.name | cgi_escape }}",
      "badge": "Speaker",
      "icon": "👤",
      "keywords": {{ kw_str | jsonify }}
    },
  {% endfor %}
  {% for topic in site.data.interview_topics.items %}
    {% assign title_str = "Topic: " | append: topic.topic | capitalize %}
    {% assign kw_str = "interview topic theme oral history ugtastic whois tech community " | append: topic.topic | append: " " | append: topic.slug %}
    {
      "title": {{ title_str | jsonify }},
      "url": "/interviews/topics/#{{ topic.slug }}",
      "badge": "Topic",
      "icon": "💡",
      "keywords": {{ kw_str | jsonify }}
    },
  {% endfor %}
  {% for post in site.posts %}
    {% assign kw_str = "article post writing blog " | append: post.title | append: " " | append: post.categories | join: " " | append: " " | append: post.tags | join: " " %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "badge": {{ post.date | date: "%Y" | jsonify }},
      "icon": "✍️",
      "keywords": {{ kw_str | jsonify }}
    }{% if forloop.last == false %},{% endif %}
  {% endfor %}
]
