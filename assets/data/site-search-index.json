  {% for pos_id in site.data.resume.timeline.history %}
    {% assign pos = site.data.resume.positions[pos_id] %}
    {% if pos and pos.company and pos.title %}
      {
        "title": {{ pos.company | append: " — " | append: pos.title | jsonify }},
        "url": "/resume/positions/{{ pos_id }}/",
        "badge": {{ pos.dates | default: "Position" | jsonify }},
        "icon": "🏢",
        "keywords": {{ "position experience " | append: pos.company | append: " " | append: pos.title | append: " " | append: pos.dates | append: " " | append: pos.summary | jsonify }}
      },
    {% endif %}
  {% endfor %}
  {% for interviewee in site.data.interviewees_index.interviewees %}
    {
      "title": {{ "Interview: " | append: interviewee.name | jsonify }},
      "url": {{ interviewee.url | jsonify }},
      "badge": "Interview",
      "icon": "🎙️",
      "keywords": {{ "interview speaker oral history " | append: interviewee.name | append: " " | append: interviewee.title | append: " " | append: interviewee.company | jsonify }}
    },
  {% endfor %}
  {% for topic in site.data.interview_topics.topics %}
    {
      "title": {{ "Topic: " | append: topic.title | jsonify }},
      "url": "/interviews/topics/#{{ topic.slug }}",
      "badge": "Topic",
      "icon": "💡",
      "keywords": {{ "interview topic theme " | append: topic.title | append: " " | append: topic.description | jsonify }}
    },
  {% endfor %}
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "badge": {{ post.date | date: "%Y" | jsonify }},
      "icon": "✍️",
      "keywords": {{ "article post writing " | append: post.title | append: " " | append: post.categories | join: " " | append: " " | append: post.tags | join: " " | jsonify }}
    }{% if forloop.last == false %},{% endif %}
  {% endfor %}
]
