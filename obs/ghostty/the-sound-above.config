# Ghostty Broadcast Terminal Configuration: The Sound Above
# High-contrast, tear-free Metal rendering optimized for OBS streaming and video capture.
# Aligned to the canonical Craftsmanship theme contract (Digital Patina & Editorial Craft).

title = "The Sound Above - Terminal"

# Typography (crisp 18pt on 1080p YouTube / mobile video compression)
font-family = FiraCode Nerd Font Mono
font-style = Retina
font-size = 18
font-thicken = true
adjust-cell-height = 10%

# Theme: canonical Craftsmanship broadcast palette
theme = craftsmanship
background-opacity = 1.0
unfocused-split-opacity = 0.92

# Window Geometry, Persistence, and Chrome
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
window-save-state = always
macos-titlebar-style = transparent

# Rendering and Frame Pacing
window-vsync = true

# Cursor (solid block avoids video frame-rate beat frequency / flicker)
cursor-style = block
cursor-style-blink = false

# Recording Ergonomics & Silence (no bells, no update popups, no accidental close)
bell-features = no-system,no-audio,no-attention,no-title,no-border
auto-update = off
confirm-close-surface = true
mouse-hide-while-typing = true

# Shell & Keyboard Parity (matches zdots / adots Option=Esc+ standard)
shell-integration = zsh
macos-option-as-alt = true
scrollback-limit = 10000000
