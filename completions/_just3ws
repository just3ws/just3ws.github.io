#compdef just3ws pipeline

# Zsh completion script for just3ws and pipeline control plane CLI
# Autocompletes domains, actions, and flags inspired by kubectl and zdots

_just3ws() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show usage and options]' \
    '1:domain:(lake media validate data site)' \
    '*::action:->actions'

  case $state in
    actions)
      case $words[1] in
        lake)
          _values 'lake action' \
            'build[Harvest repositories, commits, and compile datalake]' \
            'query[Full-text search in ecosystem datalake]' \
            'timeline[Display chronological milestone timeline]' \
            'stats[Display datalake summary metrics]' \
            'duckdb[Execute DuckDB analytical SQL query]' \
            'sql[Execute SQLite3 SQL query]'
          ;;
        media)
          _values 'media action' \
            'intake[Run or check media intake pipeline]' \
            'stream[Run near-realtime SSE telemetry streamer]' \
            'swiftbar[Update SwiftBar menu bar status]' \
            'stage[Stage or rehearse episode broadcast]' \
            'patreon[Query or sync Patreon roster and campaign]' \
            'episode[Open episode workbench]' \
            'youtube[Inspect YouTube operations cockpit]' \
            'teleprompter[Compile 6-act broadcast teleprompter script]' \
            'textream[Generate native Textream JSON document]' \
            'dedupe[Deduplicate YouTube uploads and playlists]' \
            'status[Show live status of all queues and daemons]'
          ;;
        validate)
          _values 'validate action' \
            'fast[Run fast pre-commit validation gates]' \
            'obs[Verify OBS scenes and overlays]' \
            'site[Verify rendered site contracts]' \
            'all[Run complete verification suite]'
          ;;
        data)
          _values 'data action' \
            'generate[Generate declarative site data]' \
            'graph[Regenerate archive knowledge graph]' \
            'semantic-graph[Generate semantic knowledge graph]' \
            'semantic-audit[Audit semantic knowledge graph]' \
            'sitemap[Regenerate sitemap]' \
            'legacy-routes[Compile legacy route remapping table]' \
            'sync-prompts[Synchronize episode prompts]'
          ;;
        site)
          _values 'site action' \
            'build[Build Jekyll site locally]' \
            'test[Run Jekyll test suite]' \
            'ci[Run CI verification]' \
            'verify[Run smoke and contract verification]' \
            'smoke[Run Playwright smoke tests]' \
            'remap[Test legacy route remapping]' \
            'resumes[Regenerate resume PDF surfaces]' \
            'install[Deploy and link localhost environment]' \
            'server[Run local development server]'
          ;;
      esac
      ;;
  esac
}

_just3ws "$@"
