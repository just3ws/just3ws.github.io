#!/usr/bin/env sh
# ---
# name: pipeline
# domain: root
# purpose: Unified platform operational pipeline router across media, validate, data, and site
# usage: bin/pipeline <domain> <action> [options] OR bin/pipeline <legacy-command> [options]
# description: Central operational gateway for just3ws. Coordinates video intake,
#   near-realtime streaming, OBS validation, datalake compilation, and site builds.
# ---
# ponytail: clean shell router with flat backward compatibility;
# upgrade trigger: migrate to Thor/Commander CLI if complex argument flag parsing is required.
set -eu

usage() {
  cat <<'USAGE'
Usage: ./bin/pipeline <domain> <action> [options]
       ./bin/pipeline <legacy-command> [options]

Namespaces:
  media     Media intake, streaming telemetry, SwiftBar, and YouTube publishing.
            Actions: intake, stream, swiftbar, stage, patreon, episode, youtube, teleprompter, textream, sync-prompts, dedupe, query, status.
  validate  Repository hygiene, OBS assertions, rendered site checks.
            Actions: fast, obs, site, all.
  lake      Ecosystem datalake across GitHub orgs, git commits, artifacts, timeline.
            Actions: build, query, timeline, stats, duckdb, sql.
  data      Interview data generation, archive graph, semantic artifacts, sitemap.
            Actions: generate, graph, semantic-graph, semantic-audit, semantic-snapshot, sitemap, legacy-routes, sync-prompts.
  site      Jekyll site lifecycle, testing, CI verification, local deployment.
            Actions: build, test, ci, verify, smoke, remap, resumes, install, server.

Flat / Legacy Commands (Backward Compatible):
  generate, build, test, validate, verify, knowledge-graph, semantic-graph,
  semantic-audit, semantic-snapshot, smoke, sitemap, ci, resumes, youtube,
  episode, patreon, stage, intake, stream, swiftbar, teleprompter, textream,
  sync-prompts, help.
USAGE
}

run_media() {
  action="${1:-status}"
  shift || true
  case "$action" in
    intake|drive-intake)
      if [ $# -eq 0 ]; then
        ruby bin/intake_drive_video.rb --status
      else
        ruby bin/intake_drive_video.rb "$@"
      fi
      ;;
    scan)
      if curl -s --max-time 1 http://127.0.0.1:32000/up >/dev/null 2>&1; then
        echo "Triggering intake scan on media-pipeline service (port 32000)..."
        curl -s -H "Accept: application/json" -X POST http://127.0.0.1:32000/operations/scan | jq .
      else
        ruby bin/intake_drive_video.rb --scan
      fi
      ;;
    stream|live-stream)
      if curl -s --max-time 1 http://127.0.0.1:32000/up >/dev/null 2>&1; then
        echo "media-pipeline microservice is active at https://media-pipeline.localhost"
        echo "Tailing live SSE telemetry stream (Ctrl-C to stop)..."
        curl -N -s http://127.0.0.1:32000/live_stream
      else
        ruby bin/live_dashboard_streamer.rb "$@"
      fi
      ;;
    swiftbar|bar)
      if [ -x "$HOME/.swiftbar/media-pipeline.30s.sh" ]; then
        "$HOME/.swiftbar/media-pipeline.30s.sh" "$@"
      elif [ -x /Users/mike/github.com/just3ws/media-pipeline/bin/media-pipeline-swiftbar ]; then
        /Users/mike/github.com/just3ws/media-pipeline/bin/media-pipeline-swiftbar "$@"
      else
        ruby bin/youtube-swiftbar "$@"
      fi
      ;;
    stage|rehearse)
      if [ $# -eq 0 ]; then
        ruby bin/stage_episode_workflow.rb --all
      else
        ruby bin/stage_episode_workflow.rb "$@"
      fi
      ;;
    patreon)
      if [ $# -eq 0 ]; then
        ruby bin/patreon_pipeline.rb status
      else
        ruby bin/patreon_pipeline.rb "$@"
      fi
      ;;
    episode|workbench)
      if [ $# -eq 0 ]; then
        ruby bin/episode_workbench.rb list
      else
        ruby bin/episode_workbench.rb "$@"
      fi
      ;;
    youtube|ops|cockpit)
      if [ $# -eq 0 ]; then
        ruby bin/youtube_pipeline.rb status
      else
        ruby bin/youtube_pipeline.rb "$@"
      fi
      ;;
    query)
      ruby bin/query_pipeline.rb "$@"
      ;;
    status)
      if [ $# -eq 0 ]; then
        ruby bin/query_pipeline.rb
      else
        ruby bin/query_pipeline.rb "$@"
      fi
      ;;
    teleprompter|prompter)
      ruby bin/generate_sound_above_teleprompter.rb "$@"
      ;;
    textream)
      if [ $# -eq 0 ]; then
        ruby bin/generate_sound_above_teleprompter.rb -e 1 --open
      elif [ "$1" = "all" ] || [ "$1" = "--all" ]; then
        ruby bin/generate_sound_above_teleprompter.rb --all-textream
      else
        ruby bin/generate_sound_above_teleprompter.rb "$@"
      fi
      ;;
    halt|pause)
      if curl -s --max-time 1 http://127.0.0.1:32000/up >/dev/null 2>&1; then
        echo "Pausing media_processing queue via media-pipeline (port 32000)..."
        curl -s -H "Accept: application/json" -X POST http://127.0.0.1:32000/operations/pause | jq .
      else
        ruby bin/intake_drive_video.rb --halt
      fi
      ;;
    stop)
      if curl -s --max-time 1 http://127.0.0.1:32000/up >/dev/null 2>&1; then
        echo "Pausing media_processing queue via media-pipeline (port 32000)..."
        curl -s -H "Accept: application/json" -X POST http://127.0.0.1:32000/operations/pause | jq .
      else
        ruby bin/intake_drive_video.rb --stop
      fi
      ;;
    resume)
      if curl -s --max-time 1 http://127.0.0.1:32000/up >/dev/null 2>&1; then
        echo "Resuming media_processing queue via media-pipeline (port 32000)..."
        curl -s -H "Accept: application/json" -X POST http://127.0.0.1:32000/operations/resume | jq .
      else
        ruby bin/intake_drive_video.rb --resume
      fi
      ;;
    sync-prompts|prompts)
      ruby bin/sync_topic_prompts.rb "$@"
      ;;
    dedupe|clean-playlists)
      ruby bin/clean_and_sync_youtube_playlists.rb "$@"
      ;;
    sweep|sweeper)
      ruby bin/youtube_sweeper.rb "$@"
      ;;
    cadence|drift)
      ruby bin/analyze_ramblin_cadence.rb "$@"
      ;;
    help|-h|--help)
      echo "Usage: ./bin/pipeline media <intake|stream|swiftbar|stage|patreon|episode|youtube|teleprompter|textream|sync-prompts|dedupe|sweep|cadence|halt|stop|resume|query|status> [options]"
      ;;
    *)
      echo "Unknown media action: $action" >&2
      echo "Available: intake, stream, swiftbar, stage, patreon, episode, youtube, teleprompter, textream, sync-prompts, dedupe, sweep, cadence, halt, stop, resume, query, status" >&2
      exit 1
      ;;
  esac
}

run_validate() {
  action="${1:-all}"
  shift || true
  case "$action" in
    fast)
      bundle exec rake validate:fast
      ;;
    obs)
      bundle exec rake validate:obs
      ;;
    site|rendered)
      bundle exec rake validate:rendered_site
      ;;
    all)
      bundle exec rake validate
      ;;
    help|-h|--help)
      echo "Usage: ./bin/pipeline validate <fast|obs|site|all>"
      ;;
    *)
      echo "Unknown validate action: $action" >&2
      echo "Available: fast, obs, site, all" >&2
      exit 1
      ;;
  esac
}

run_data() {
  action="${1:-generate}"
  shift || true
  case "$action" in
    generate)
      bundle exec rake generate
      ;;
    graph|knowledge-graph)
      bundle exec rake knowledge_graph
      ;;
    semantic-graph)
      bundle exec rake semantic:graph
      ;;
    semantic-audit)
      bundle exec rake semantic:audit
      ;;
    semantic-snapshot)
      bundle exec rake semantic:snapshot
      ;;
    sitemap)
      bundle exec rake sitemap
      ;;
    legacy-routes|routes)
      ruby bin/generate_legacy_route_map.rb
      ;;
    ecosystem-lake|ecosystem|lake)
      ruby bin/build_ecosystem_datalake.rb "$@"
      ;;
    query-lake|query-ecosystem)
      ruby bin/query_ecosystem_datalake.rb "$@"
      ;;
    sync-prompts|prompts)
      ruby bin/sync_topic_prompts.rb "$@"
      ;;
    help|-h|--help)
      echo "Usage: ./bin/pipeline data <generate|graph|semantic-graph|semantic-audit|semantic-snapshot|sitemap|legacy-routes|ecosystem-lake|query-lake|sync-prompts>"
      ;;
    *)
      echo "Unknown data action: $action" >&2
      echo "Available: generate, graph, semantic-graph, semantic-audit, semantic-snapshot, sitemap, legacy-routes, ecosystem-lake, query-lake, sync-prompts" >&2
      exit 1
      ;;
  esac
}

run_lake() {
  action="${1:-stats}"
  shift || true
  case "$action" in
    build|sync|rebuild)
      ruby bin/build_ecosystem_datalake.rb "$@"
      ;;
    query|search|find)
      ruby bin/query_ecosystem_datalake.rb --search "$@"
      ;;
    timeline|history|chronology)
      ruby bin/query_ecosystem_datalake.rb --timeline "$@"
      ;;
    stats|status|summary)
      ruby bin/query_ecosystem_datalake.rb --stats "$@"
      ;;
    duckdb|duck)
      ruby bin/query_ecosystem_datalake.rb --duckdb "$@"
      ;;
    sql)
      ruby bin/query_ecosystem_datalake.rb --sql "$@"
      ;;
    help|-h|--help)
      echo "Usage: ./bin/pipeline lake <build|query|timeline|stats|duckdb|sql> [options]"
      ;;
    *)
      ruby bin/query_ecosystem_datalake.rb "$action" "$@"
      ;;
  esac
}

run_site() {
  action="${1:-build}"
  shift || true
  case "$action" in
    build)
      bundle exec rake build
      ;;
    test)
      bundle exec rake test
      ;;
    ci)
      bundle exec rake ci
      ;;
    verify)
      bundle exec rake verify
      ;;
    smoke)
      bundle exec rake smoke
      ;;
    remap|routes)
      ruby bin/remap_legacy_routes.rb "$@"
      ;;
    resumes|resume-pdfs)
      bundle exec rake resumes
      ;;
    install)
      bin/install-localhost
      ;;
    server)
      bin/server
      ;;
    help|-h|--help)
      echo "Usage: ./bin/pipeline site <build|test|ci|verify|smoke|remap|resumes|install|server>"
      ;;
    *)
      echo "Unknown site action: $action" >&2
      echo "Available: build, test, ci, verify, smoke, remap, resumes, install, server" >&2
      exit 1
      ;;
  esac
}

cmd="${1:-help}"
case "$cmd" in
  # Namespaces
  media)
    shift
    run_media "$@"
    ;;
  validate)
    shift
    if [ $# -eq 0 ]; then
      bundle exec rake validate
    else
      run_validate "$@"
    fi
    ;;
  lake)
    shift
    run_lake "$@"
    ;;
  data)
    shift
    run_data "$@"
    ;;
  site)
    shift
    run_site "$@"
    ;;

  # Flat / Backward-Compatible Aliases
  lake-timeline|timeline)
    shift
    run_lake timeline "$@"
    ;;
  lake-stats)
    shift
    run_lake stats "$@"
    ;;
  lake-duckdb|duckdb)
    shift
    run_lake duckdb "$@"
    ;;
  generate)
    run_data generate
    ;;
  build)
    run_site build
    ;;
  test)
    run_site test
    ;;
  verify)
    run_site verify
    ;;
  ci)
    run_site ci
    ;;
  smoke)
    run_site smoke
    ;;
  sitemap)
    run_data sitemap
    ;;
  knowledge-graph)
    run_data graph
    ;;
  semantic-graph)
    run_data semantic-graph
    ;;
  semantic-audit)
    run_data semantic-audit
    ;;
  semantic-snapshot)
    run_data semantic-snapshot
    ;;
  resumes|resume-pdfs)
    run_site resumes
    ;;
  youtube|youtube-pipeline)
    shift
    run_media youtube "$@"
    ;;
  episode|workbench|episode-workbench)
    shift
    run_media episode "$@"
    ;;
  patreon|patreon-pipeline)
    shift
    run_media patreon "$@"
    ;;
  stage|rehearse)
    shift
    run_media stage "$@"
    ;;
  intake|drive-intake|media-intake)
    shift
    run_media intake "$@"
    ;;
  stream|live-stream|dashboard-stream)
    shift
    run_media stream "$@"
    ;;
  swiftbar|youtube-swiftbar)
    shift
    run_media swiftbar "$@"
    ;;
  teleprompter|prompter)
    shift
    run_media teleprompter "$@"
    ;;
  textream)
    shift
    run_media textream "$@"
    ;;
  pause|halt)
    shift
    run_media halt "$@"
    ;;
  stop)
    shift
    run_media stop "$@"
    ;;
  resume)
    shift
    run_media resume "$@"
    ;;
  sync-prompts|prompts)
    shift
    run_media sync-prompts "$@"
    ;;
  query|pipeline-status)
    shift
    run_media query "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
