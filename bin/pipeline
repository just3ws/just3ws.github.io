#!/usr/bin/env sh
# Unified pipeline runner using Rake
set -eu

usage() {
  cat <<'USAGE'
Usage: ./bin/pipeline <command>

Command grammar:
  <command> ::= generate | build | test | validate | verify | knowledge-graph | semantic-graph | semantic-audit | semantic-snapshot | smoke | sitemap | ci | resumes | youtube | episode | patreon | stage | intake | help

Commands:
  generate  Regenerate data-driven interview/video pages.
  build     Run generate and build _site with Jekyll.
  test      Run RSpec unit tests.
  validate  Run data/SEO/semantic/link checks against _site.
  knowledge-graph Audit the canonical archive relationship graph.
  semantic-graph Generate JSON-LD semantic graph artifacts from rendered _site.
  semantic-audit Generate consolidated semantic quality report from validator artifacts.
  semantic-snapshot Generate backlog/docs/architecture/semantic-graph.md from semantic artifacts.
  smoke     Run Playwright smoke checks against built _site.
  sitemap   Print sitemap coverage summary from built _site.
  ci        Regenerate, build, test, and validate locally.
  verify    Build, test, and validate committed artifacts without regeneration.
  resumes   Regenerate PDF resumes to $HOME/Desktop/resumes.
  youtube   Run YouTube publishing pipeline CLI (status, audit, telemetry, schedule).
  episode   Run Episode Semantic Dossier & Workbench CLI (list, show, compile, validate, cue).
  patreon   Run Patreon API v2 integration and credits CLI (status, members, credits, sync).
  stage     Run 37-episode staging & rehearsal workflow harness across all 7 gates.
  intake    Run Google Drive media intake pipeline (status, process, watch, dry-run).
  help      Show this help.
USAGE
}

case "${1:-help}" in
  generate)
    bundle exec rake generate
    ;;
  build)
    bundle exec rake build
    ;;
  test)
    bundle exec rake test
    ;;
  validate)
    bundle exec rake validate
    ;;
  verify)
    bundle exec rake verify
    ;;
  knowledge-graph)
    bundle exec rake knowledge_graph
    ;;
  semantic-graph)
    bundle exec rake semantic:graph
    ;;
  semantic-audit)
    bundle exec rake semantic:audit
    ;;
  semantic-snapshot)
    bundle exec rake semantic:snapshot
    ;;
  smoke)
    bundle exec rake smoke
    ;;
  sitemap)
    bundle exec rake sitemap
    ;;
  ci)
    bundle exec rake ci
    ;;
  resumes|resume-pdfs)
    bundle exec rake resumes
    ;;
  youtube|youtube-pipeline)
    shift
    ruby bin/youtube_pipeline.rb "${@:-status}"
    ;;
  episode|workbench|episode-workbench)
    shift
    ruby bin/episode_workbench.rb "${@:-list}"
    ;;
  patreon|patreon-pipeline)
    shift
    ruby bin/patreon_pipeline.rb "${@:-status}"
    ;;
  stage|rehearse)
    shift
    ruby bin/stage_episode_workflow.rb "${@:---all}"
    ;;
  intake|drive-intake|media-intake)
    shift
    ruby bin/intake_drive_video.rb "${@:---status}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
