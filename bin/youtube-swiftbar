#!/usr/bin/env ruby
# frozen_string_literal: true

# Compatibility entrypoint. The media-pipeline plugin owns queue and publication
# health, and includes the just3ws site context dependency in its system view.

require "yaml"

root_dir = File.expand_path("..", __dir__)
config_path = File.join(root_dir, "_data", "media_intake_targets.yml")
config = YAML.safe_load(File.read(config_path)) || {}
workdir = ENV["MEDIA_PIPELINE_WORKDIR"] || config["service_working_directory"] || "~/github.com/just3ws/media-pipeline"
plugin = File.join(File.expand_path(workdir), "bin", "just3ws-media-pipeline-swiftbar")

abort "Media Pipeline SwiftBar plugin is unavailable: #{plugin}" unless File.executable?(plugin)

exec(plugin, *ARGV)
