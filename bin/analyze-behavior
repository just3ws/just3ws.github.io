#!/usr/bin/env bash
# bin/analyze-behavior - Local AI diagnostic bridge for Rails/Postgres systems.

set -e

# Configuration
LOCAL_MODEL_API="${LOCAL_MODEL_API:-http://localhost:11434/v1}" # Default to Ollama
MODEL="${MODEL:-llama3}"
INPUT_DIR="tmp/diagnostic"
REPORT_FILE="tmp/diagnostic/behavior-report.md"

mkdir -p "$INPUT_DIR"

usage() {
  echo "Usage: $0 [logs|schema|queries|plans] [file_path]"
  echo ""
  echo "Commands:"
  echo "  logs <path>    Analyze Rails request logs for anomalies"
  echo "  schema <path>  Identify hotspots and coupling in schema.rb"
  echo "  queries <path> Rank and cluster pg_stat_statements CSV"
  echo "  plans <path>   Summarize EXPLAIN (FORMAT JSON) output"
  exit 1
}

if [ $# -lt 2 ]; then
  usage
fi

TYPE=$1
FILE=$2

if [ ! -f "$FILE" ]; then
  echo "Error: File $FILE not found."
  exit 1
fi

echo "--- Diagnostic Analysis: $TYPE ($FILE) ---"

case $TYPE in
  logs)
    PROMPT="Apply the **Panoramic View** framework to these Rails logs. 
1. Cluster all Request IDs sharing a common Entry Point (Affiliate/API). 
2. Trace to their final Exit Point (DB commit/200 OK). 
3. Identify 'orphan' requests with no visible exit. 
4. Map the 'error topography'—where do these orphans stall? Quote evidence."
    ;;
  schema)
    PROMPT="Apply the **ACQ Mapping** framework to this schema.rb. 
1. Catalog every table responsible for the Acquisitions lane. 
2. Identify high-risk coupling with legacy silos. 
3. Perform **Orphan Discovery**: search for abandoned table prefixes (e.g., clarity_). 
4. Identify fields likely containing PII (9-digit patterns)."
    ;;
  queries)
    PROMPT="You are a Postgres DBA. Analyze this pg_stat_statements CSV. Rank queries by total_exec_time. Cluster similar query shapes. Identify the top 3 candidates for indexing or refactoring."
    ;;
  plans)
    PROMPT="You are a Postgres Performance Expert. Analyze this EXPLAIN (FORMAT JSON) plan. Summarize the bottleneck in plain English (e.g., Seq Scan on large table, Nested Loop join). Compare planner estimates to reality."
    ;;
  *)
    usage
    ;;
esac

# Note: This is a boilerplate bridge. In a real environment, this would call curl/local CLI.
# For now, it simulates the 'evidence selection' mandate by echoing the prompt.
echo "Sending to local AI ($MODEL)..."
echo "Prompt: $PROMPT"
echo "Input size: $(wc -c < "$FILE") bytes"
echo ""
echo "--- ANALYSIS RESULTS (SIMULATED) ---"
echo "1. Evidence-backed hypothesis: [Analysis would go here]"
echo "2. Risk ranking: [High/Medium/Low]"
echo "3. Next recommended move: [Step]"
echo ""
echo "Report generated at: $REPORT_FILE"
