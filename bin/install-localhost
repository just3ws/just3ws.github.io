#!/usr/bin/env bash

# ---
# name: install-localhost
# domain: site
# purpose: bin/install-localhost - serve this site persistently at https://www.just3ws.localhost
# usage: bin/install-localhost
# ---

# bin/install-localhost — serve this site persistently at https://www.just3ws.localhost
#                         (bare just3ws.localhost 301s to it, mirroring prod)
#
# Installs the project-owned nginx vhost (nginx/just3ws.localhost.conf) into the
# Homebrew nginx servers/ dir, mirroring how my.localhost / zdots.localhost are
# deployed. nginx serves the static _site/ build, so the site is up whenever
# nginx is — no dev server required.
#
# Two steps still need YOUR system access (keychain / sudo); this script prints
# the exact commands rather than running privileged operations for you:
#   1. Add just3ws.localhost to the shared TLS cert SAN list (mkcert).
#   2. Reload nginx.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
VHOST_SRC="$REPO/nginx/just3ws.localhost.conf"
NGINX_PREFIX="/opt/homebrew/etc/nginx"
VHOST_DST="$NGINX_PREFIX/servers/just3ws.conf"
CERT="$NGINX_PREFIX/certs/zdots-local.pem"
# Web root nginx-as-nobody can read (a 700 home dir can't be served directly).
WEBROOT="/opt/homebrew/var/www/just3ws.github.io"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

[ -f "$VHOST_SRC" ] || { echo "missing $VHOST_SRC"; exit 1; }
[ -d "$NGINX_PREFIX/servers" ] || { echo "nginx not set up at $NGINX_PREFIX — run zdots bootstrap first"; exit 1; }

# Build if needed (or if _site was built in production mode without localhost cockpits), then publish to the web root nginx can read.
if [ ! -d "$REPO/_site" ] || [ ! -f "$REPO/_site/youtube/dashboard/index.html" ]; then
  info "Building localhost site (including private cockpits)…"
  ( cd "$REPO" && JEKYLL_ENV=development SKIP_IMAGE_OPTIMIZATION=true bundle exec jekyll build && rm -f _site/AGENTS.html _site/AGENTS.md )
fi
info "Publishing _site → $WEBROOT"
mkdir -p "$WEBROOT"
rsync -a --delete "$REPO/_site/" "$WEBROOT/"
# nginx workers (nobody) need traverse on www + read on our tree; siblings stay private.
chmod o+x "$(dirname "$WEBROOT")"
chmod -R o+rX "$WEBROOT"

info "Installing vhost → $VHOST_DST"
cp "$VHOST_SRC" "$VHOST_DST"

# Does the shared cert already cover BOTH just3ws hosts?
cert_ok=false
if [ -f "$CERT" ]; then
  sans="$(openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null)"
  if grep -q "just3ws.localhost" <<<"$sans" && grep -q "www.just3ws.localhost" <<<"$sans"; then
    cert_ok=true
  fi
fi

echo
if [ "$cert_ok" = true ]; then
  info "TLS cert already covers just3ws.localhost + www.just3ws.localhost ✓"
else
  warn "TLS cert is missing just3ws.localhost and/or www.just3ws.localhost."
  info "zdots' nginx-regen-certs scans every deployed vhost's server_name, so with"
  info "this vhost now installed it will pick both up automatically (keychain prompt):"
  cat <<'EOF'

  nginx-regen-certs          # unions the new names into the cert, validates, reloads
  # or, to rebuild the SAN list purely from live vhosts:
  nginx-regen-certs --prune

EOF
fi

echo
info "If you regenerated the cert above, nginx was already reloaded. Otherwise:"
cat <<'EOF'

  nginx -t
  sudo launchctl kickstart -k system/homebrew.mxcl.nginx

  # (Do NOT use `sudo brew services restart nginx` — it takes root ownership
  #  of Homebrew paths. Kickstart is the zdots-blessed restart.)
EOF

echo
info "Then browse: https://just3ws.localhost"
info "Refresh content with: bundle exec jekyll build && bin/install-localhost"
