#!/usr/bin/env ruby
# frozen_string_literal: true

# ---
# name: broadcast
# domain: media
# purpose: ==============================================================================
# usage: bin/broadcast
# ---

# ==============================================================================
# bin/broadcast
#
# Unified broadcast director and automation interface for Mike Hall.
# Directs three broadcast archetypes:
#   1. Rewatch:  "The Sound Above" (UGtastic oral history rewatch series)
#   2. Errata:   "Errata" (readings, concepts, live demos, stories, artifacts, behind the scenes)
#   3. Dialogue: "The Room" (invited guest dialogues and roundtables)
#
# Enforces zero em dashes, hardware contracts, and overlay synchronization.
# ==============================================================================

require "json"
require "optparse"
require "fileutils"

ROOT_DIR = File.expand_path("..", __dir__)
OBS_DIR = File.join(ROOT_DIR, "obs")
SEQUENCE_MANIFEST = File.join(OBS_DIR, "curation", "sequence-manifest.json")
ERRATA_MANIFEST = File.join(OBS_DIR, "curation", "errata-manifest.json")
WORKBENCH_MANIFEST = File.join(OBS_DIR, "curation", "workbench-manifest.json")
OVERLAY_STATE = File.join(OBS_DIR, "overlays", "overlay-state.json")
VALIDATOR_SCRIPT = File.join(ROOT_DIR, "bin", "validate_obs_setup.rb")

def load_json(path)
  return nil unless File.exist?(path)
  JSON.parse(File.read(path))
rescue JSON::ParserError => e
  warn "Error reading JSON from #{path}: #{e.message}"
  nil
end

def write_json(path, data)
  File.write(path, JSON.pretty_generate(data) + "\n")
  if path == OVERLAY_STATE
    webroot_state = '/opt/homebrew/var/www/just3ws.github.io/obs/overlays/overlay-state.json'
    File.write(webroot_state, JSON.pretty_generate(data) + "\n") if File.directory?(File.dirname(webroot_state))
  end
end

def print_status
  state = load_json(OVERLAY_STATE)
  unless state
    puts "No active overlay state found at #{OVERLAY_STATE}"
    return
  end

  type = (state["broadcast_type"] || "rewatch").to_s.downcase
  puts "=================================================================="
  puts " 🎙️ BROADCAST OVERLAY CUE"
  puts "=================================================================="
  puts "Archetype:       #{type.upcase}"
  puts "Series Title:    #{state.dig('stream', 'series_title')}"
  puts "Series Subtitle: #{state.dig('stream', 'series_subtitle')}"
  puts "Host:            #{state.dig('stream', 'host')}"
  puts "Cue Topic:       #{state.dig('stream', 'topic')}"
  puts "Cue State:       cued (overlay metadata only)"
  puts "Capture State:   not inspected; verify in OBS"
  puts "------------------------------------------------------------------"

  case type
  when "errata"
    err = state["errata"] || {}
    puts "Mode:            #{err['mode']&.upcase}"
    puts "Title:           #{err['title']}"
    puts "Subtitle:        #{err['subtitle']}"
    puts "Citation:        #{err['citation']}"
    puts "Excerpt/Thesis:  #{err['excerpt_or_thesis']}"
    puts "Artifact Year:   #{err['artifact_year']}" if err['artifact_year']
  when "dialogue"
    dia = state["dialogue"] || {}
    guests = (dia["guests"] || []).map do |g|
      label = g["name"].to_s
      label += " (#{g['role']})" if g["role"] && !g["role"].empty?
      label += " [#{g['affiliation']}]" if g["affiliation"] && !g["affiliation"].empty?
      label
    end
    puts "Guests:          #{guests.empty? ? 'None cued' : guests.join(', ')}"
    puts "Topic:           #{dia['topic']}"
    puts "Prompt Question: #{dia['prompt']}"
  else
    ep = state["episode"] || {}
    ep_num_str = ep['number'] ? "##{ep['number']}" : "(Unspecified)"
    puts "Episode:         #{ep_num_str} - #{ep['title']}"
    puts "Interviewee:     #{ep['interviewee']}"
    puts "Conference:      #{ep['conference']} (#{ep['year']})"
    puts "Era:             #{ep['era']}"
    puts "Sound Above Q:   #{ep['sound_above_prompt']}"
  end
  puts "=================================================================="
end

def list_curated_catalog
  seq = load_json(SEQUENCE_MANIFEST)
  err = load_json(ERRATA_MANIFEST)

  puts "=================================================================="
  puts " 📚 CURATED BROADCAST CATALOG"
  puts "=================================================================="
  puts ""
  if seq && seq["episodes"]
    target = seq.fetch("season_one_target", 17).to_i
    episodes = seq["episodes"]
    later_count = [episodes.length - target, 0].max
    puts "--- THE SOUND ABOVE: #{target}-INTERVIEW SEASON ONE WORKING TARGET ---"
    puts "    #{later_count} additional archive candidates are unscheduled."
    seq["episodes"].each do |ep|
      status_pill = ep["number"].to_i <= target ? "[Season One target]" : "[Later candidate]"
      puts format("  #%02d: %-25s | %-16s | %s %s",
                  ep["number"],
                  ep["interviewee"][0..24],
                  ep["conference"][0..15],
                  ep["title"][0..35],
                  status_pill)
    end
  else
    puts "--- THE SOUND ABOVE ---"
    puts "  Sequence manifest unavailable."
  end

  puts ""
  puts "--- ARCHETYPE 2: ERRATA PRE-CUED ENTRIES ---"
  if err && err["items"]
    err["items"].each do |item|
      puts format("  %-38s | %-8s | %s",
                  item["id"],
                  item["mode"],
                  item["title"][0..40])
    end
  else
    puts "  Errata manifest unavailable."
  end
  puts "=================================================================="
end

def cue_rewatch(episode_num, overrides = {})
  seq = load_json(SEQUENCE_MANIFEST)
  state = load_json(OVERLAY_STATE) || {}

  is_unspecified = episode_num.nil? || episode_num.to_s.strip.empty? ||
                   episode_num.to_s == "unspecified" || episode_num.to_s == "intro"

  ep = if is_unspecified
         {
           "number" => overrides[:number],
           "title" => overrides[:title] || "Series Introduction",
           "interviewee" => overrides[:guest] || "Mike Hall",
           "role" => "Host & Curator",
           "conference" => overrides[:conference] || "The Sound Above Studio",
           "location" => "Crystal Lake, IL",
           "year" => (overrides[:year] || Time.now.year).to_s,
           "era_name" => overrides[:era] || "The AI Horizon",
           "sound_above_inquiry" => overrides[:prompt] || overrides[:subtitle] || "Plans, ideas, and general structure"
         }
       else
         unless seq && seq["episodes"]
           warn "Cannot cue episode: sequence manifest not found."
           exit 1
         end

         requested_number = Integer(episode_num.to_s, 10) rescue nil
         if requested_number && requested_number <= 0
           warn "Episode #{requested_number} was extracted from The Sound Above. Use 'bin/broadcast --workbench' to cue Studio Workbench sessions."
           exit 1
         end

         found = seq["episodes"].find { |e| e["number"].to_i == requested_number } if requested_number
         if found.nil? && requested_number
           dossier_path = File.join(ROOT_DIR, "_data", "episodes", format("episode-%02d.yml", requested_number))
           if File.exist?(dossier_path)
             require "yaml"
             dossier = YAML.safe_load(File.read(dossier_path)) rescue nil
             if dossier
               found = {
                 "number" => dossier["episode"] || episode_num.to_i,
                 "title" => dossier["title"],
                 "interviewee" => dossier["interviewee"] || "Mike Hall",
                 "conference" => dossier["conference"] || "Errata Studio Walkthrough",
                 "location" => dossier["location"] || "Crystal Lake, IL",
                 "year" => dossier["year"] || 2026,
                 "era_name" => dossier["era_name"] || "The AI Horizon",
                 "sound_above_inquiry" => (dossier.dig("narrative", "core_inquiry") || dossier["sound_above_inquiry"]),
                 "role" => dossier["role"] || "Host and Curator"
               }
             end
           end
         end

         unless found
           warn "Episode ##{episode_num} not found in sequence manifest or episode dossiers."
           exit 1
         end
         found
       end

  state["broadcast_type"] = "rewatch"
  state["stream"] ||= {}
  state["stream"]["series_title"] = overrides[:series] || "The Sound Above"
  state["stream"]["series_subtitle"] = "UGtastic Rewatch: Learning About People in Tech"
  state["stream"]["host"] = "Mike Hall (Staff Software Engineer & SCMC Co-Founder)"
  state["stream"]["status"] = "cued"
  state["stream"]["topic"] = if is_unspecified
                               "#{overrides[:title] || ep['title']}: #{overrides[:prompt] || overrides[:subtitle] || ep['sound_above_inquiry']} (The Sound Above)"
                             else
                               "Rewatching #{ep['interviewee']} (#{ep['conference']}): #{ep['title']}"
                             end

  state["episode"] = {
    "number" => is_unspecified ? overrides[:number] : ep["number"],
    "title" => overrides[:title] || ep["title"],
    "interviewee" => overrides[:guest] || ep["interviewee"],
    "role" => ep["role"] || "Community Practitioner",
    "conference" => overrides[:conference] || ep["conference"],
    "location" => ep["location"] || "Chicago, IL",
    "year" => (overrides[:year] || ep["year"]).to_s,
    "era" => overrides[:era] || ep["era_name"],
    "sound_above_prompt" => overrides[:prompt] || overrides[:subtitle] || ep["sound_above_inquiry"],
    "companion_links" => [
      "https://just3ws.localhost/timeline/community/",
      "https://just3ws.localhost/scmc/"
    ]
  }

  write_json(OVERLAY_STATE, state)
  if is_unspecified
    puts "Successfully cued unspecified episode (#{state['episode']['title']}) for The Sound Above broadcast."
  else
    puts "Successfully cued Episode ##{ep['number']} (#{ep['interviewee']}) for rewatch broadcast."
  end
  print_status
end

def cue_errata(options)
  state = load_json(OVERLAY_STATE) || {}
  err_manifest = load_json(ERRATA_MANIFEST)
  wb_manifest = load_json(WORKBENCH_MANIFEST)

  target_item = nil
  if (options[:mode] == "workbench" || options[:series] == "Studio Workbench") && wb_manifest && wb_manifest["items"]
    target_item = wb_manifest["items"].find do |it|
      it["id"] == options[:cue_id] ||
        (options[:title] && it["id"] == options[:title]) ||
        (options[:title] && it["title"].to_s.downcase.include?(options[:title].to_s.downcase)) ||
        (options[:title] && it["id"].end_with?(options[:title].to_s.downcase.gsub(/[^a-z0-9]+/, "-")))
    end
  end

  if target_item.nil? && options[:cue_id] && err_manifest && err_manifest["items"]
    target_item = err_manifest["items"].find { |it| it["id"] == options[:cue_id] }
    unless target_item
      warn "Errata cue ID '#{options[:cue_id]}' not found in errata manifest."
      exit 1
    end
  end

  mode = options[:mode] || target_item&.dig("mode") || "concept"
  date_str = Time.now.strftime("%B %-d, %Y")
  is_workbench = mode == "workbench"
  is_dispatch = mode == "dispatch" || mode == "bts" || is_workbench

  title = if is_workbench
            if options[:title]
              if options[:dispatch_counter]
                "Studio Workbench ##{options[:dispatch_counter]}: #{options[:title]}"
              else
                options[:title]
              end
            elsif target_item&.dig("title")
              target_item["title"]
            elsif options[:dispatch_counter]
              "Studio Workbench ##{options[:dispatch_counter]} · #{date_str}"
            else
              "Studio Workbench · #{date_str}"
            end
          elsif is_dispatch
            if options[:title]
              if options[:dispatch_counter]
                "Studio Dispatch ##{options[:dispatch_counter]}: #{options[:title]}"
              else
                options[:title]
              end
            elsif options[:dispatch_counter]
              "Studio Dispatch ##{options[:dispatch_counter]} · #{date_str}"
            else
              mode == "dispatch" ? "Studio Dispatch · #{date_str}" : "Series Update"
            end
          else
            options[:title] || target_item&.dig("title") || "Untitled Insight"
          end

  subtitle = options[:subtitle] || target_item&.dig("subtitle") ||
             (is_workbench ? "Process cinema and hands-on investigation at the desk" :
             (is_dispatch ? "Open reflections, workbench notes, and active ideas" : "Marginalia and Demonstrations"))

  citation = options[:citation] || target_item&.dig("citation") ||
             (options[:series] ? options[:series] : (is_workbench ? "Studio Workbench" : (is_dispatch ? "Mike Hall" : "Personal Archive")))

  excerpt = options[:prompt] || target_item&.dig("excerpt_or_thesis") || ""
  year = (options[:year] || target_item&.dig("year") || Time.now.strftime("%Y")).to_s

  default_series = if is_workbench
                     options[:series] || "Studio Workbench"
                   elsif is_dispatch
                     options[:series] || (mode == "bts" ? "The Sound Above" : "Mike Hall")
                   else
                     "Errata"
                   end

  default_sub = if is_workbench
                  "Process Cinema & Live Exploration"
                elsif is_dispatch
                  "Studio Dispatches & Workbench Notes"
                else
                  "Marginalia, Readings & Demonstrations"
                end

  state["broadcast_type"] = "errata"
  state["stream"] ||= {}
  state["stream"]["series_title"] = options[:series] || default_series
  state["stream"]["series_subtitle"] = default_sub
  state["stream"]["host"] = "Mike Hall (Staff Software Engineer & SCMC Co-Founder)"
  state["stream"]["status"] = "cued"
  state["stream"]["topic"] = if is_workbench
                               "#{title} (Studio Workbench)"
                             elsif is_dispatch
                               "#{title} (Studio Dispatch)"
                             else
                               "#{title} (#{mode})"
                             end

  state["errata"] = {
    "mode" => mode,
    "title" => title,
    "subtitle" => subtitle,
    "citation" => citation,
    "excerpt_or_thesis" => excerpt,
    "artifact_year" => year
  }

  write_json(OVERLAY_STATE, state)
  puts "Successfully cued #{is_workbench ? 'Studio Workbench session' : (is_dispatch ? 'Studio Dispatch' : 'Errata broadcast [' + mode.upcase + ']')}: #{title}."
  print_status
end

def cue_dialogue(options)
  state = load_json(OVERLAY_STATE) || {}

  guest_name = options[:guest] || "Invited Guest"
  role = options[:subtitle] || "Collaborator"
  affiliation = options[:conference] || ""
  topic = options[:title] || "Software Craftsmanship Dialogue"
  prompt = options[:prompt] || "Exploring shared engineering history and modern craft disciplines."

  state["broadcast_type"] = "dialogue"
  state["stream"] ||= {}
  state["stream"]["series_title"] = options[:series] || "The Room"
  state["stream"]["series_subtitle"] = "Invitational Conversations & Peer Inquiry"
  state["stream"]["host"] = "Mike Hall (Staff Software Engineer & SCMC Co-Founder)"
  state["stream"]["status"] = "cued"
  state["stream"]["topic"] = topic

  state["dialogue"] = {
    "guests" => [
      {
        "name" => guest_name,
        "role" => role,
        "affiliation" => affiliation
      }
    ],
    "topic" => topic,
    "prompt" => prompt
  }

  write_json(OVERLAY_STATE, state)
  puts "Successfully cued Dialogue broadcast with #{guest_name}: #{topic}."
  print_status
end

options = {}
opt_parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/broadcast [archetype] [options]"
  opts.separator ""
  opts.separator "Unified live broadcast director for Mike Hall (Staff Software Engineer & SCMC Co-Founder)."
  opts.separator "Directs and cues distinct broadcast formats:"
  opts.separator "  1. --rewatch <N>       The Sound Above (interview review series, 1 to 37)"
  opts.separator "  2. --workbench [ARG]   Studio Workbench (process cinema, desk investigation, problem solving)"
  opts.separator "  3. --dispatch [ARG]    Studio Dispatch (out-of-series open reflections, updates, and introductions)"
  opts.separator "  4. --errata            Errata (solo readings, concepts, live demos, artifacts)"
  opts.separator "  5. --dialogue          The Room (invited guest conversations and peer inquiry)"
  opts.separator ""
  opts.separator "Recording prep: bin/broadcast --playbook, then bin/broadcast --preflight"
  opts.separator "Cueing updates local overlay metadata. It does not start OBS or a stream."
  opts.separator ""
  opts.on("-r", "--rewatch [EPISODE]", "Cue The Sound Above episode (1 to 37, or leave blank for unspecified episode)") do |ep|
    options[:archetype] = "rewatch"
    options[:episode] = if ep.nil? || ep.empty?
                          "unspecified"
                        elsif ep.to_s =~ /^-?\d+$/
                          ep.to_i
                        else
                          ep.to_s
                        end
  end

  opts.on("--intro", "Cue an unspecified series introduction or open broadcast for The Sound Above") do
    options[:archetype] = "rewatch"
    options[:episode] = "unspecified"
    options[:title] ||= "Series Introduction"
    options[:subtitle] ||= "Plans, ideas, and general structure"
  end

  opts.on("--solo", "Cue an unspecified solo host broadcast for The Sound Above") do
    options[:archetype] = "rewatch"
    options[:episode] = "unspecified"
  end

  opts.on("-w", "--workbench [ARG]", "Cue a Studio Workbench session (process cinema & live engineering exploration)") do |arg|
    options[:mode] = "workbench"
    options[:archetype] ||= "errata"
    options[:series] ||= "Studio Workbench"
    if arg && !arg.empty?
      if arg =~ /^\d+$/
        options[:dispatch_counter] = arg.to_i
      else
        options[:title] ||= arg
      end
    end
  end

  opts.on("--dispatch [ARG]", "Cue a Studio Dispatch (out-of-series open reflection or update; optional counter or topic)") do |arg|
    options[:mode] = "dispatch"
    options[:archetype] ||= "errata"
    if arg && !arg.empty?
      if arg =~ /^\d+$/
        options[:dispatch_counter] = arg.to_i
      else
        options[:title] ||= arg
      end
    end
  end

  opts.on("-u", "--update [ARG]", "Alias for --dispatch") do |arg|
    options[:mode] = "dispatch"
    options[:archetype] ||= "errata"
    if arg && !arg.empty?
      if arg =~ /^\d+$/
        options[:dispatch_counter] = arg.to_i
      else
        options[:title] ||= arg
      end
    end
  end

  opts.on("-e", "--errata", "Direct an Errata solo broadcast (reading, concept, demo, artifact, bts, dispatch)") do
    options[:archetype] = "errata"
  end

  opts.on("-d", "--dialogue", "Direct a Dialogue broadcast with invited peers or guests") do
    options[:archetype] = "dialogue"
  end

  opts.on("--cue ID", String, "Cue pre-configured entry from errata-manifest.json by ID") do |id|
    options[:cue_id] = id
    options[:archetype] ||= "errata"
  end

  opts.separator ""
  opts.separator "Metadata Modifiers:"
  opts.on("-m", "--mode MODE", %w[reading concept demo story artifact bts dispatch workbench], "Errata mode: reading, concept, demo, story, artifact, bts, dispatch, workbench") do |m|
    options[:mode] = m
    options[:archetype] ||= "errata"
  end

  opts.on("--bts", "Shortcut for behind-the-scenes series updates and preparation") do
    options[:mode] = "bts"
    options[:archetype] ||= "errata"
  end

  opts.on("-t", "--title TITLE", String, "Broadcast topic, chapter title, or episode heading") do |t|
    options[:title] = t
  end

  opts.on("-s", "--subtitle SUBTITLE", String, "Contextual subtitle, book section, or role") do |s|
    options[:subtitle] = s
  end

  opts.on("-g", "--guest NAME", String, "Guest or interviewee name") do |g|
    options[:guest] = g
  end

  opts.on("-c", "--citation CITATION", String, "Book citation, author provenance, or artifact source") do |cit|
    options[:citation] = cit
  end

  opts.on("-p", "--prompt PROMPT", String, "Central inquiry question, book excerpt, or thesis") do |p|
    options[:prompt] = p
  end

  opts.on("-y", "--year YEAR", String, "Year or era label (e.g. 2011, 2008)") do |y|
    options[:year] = y
  end

  opts.on("--conference CONF", String, "Conference name, venue, or guest affiliation") do |conf|
    options[:conference] = conf
  end

  opts.on("--era ERA", String, "Historical era name") do |era|
    options[:era] = era
  end

  opts.on("--series SERIES", String, "Override series title banner") do |ser|
    options[:series] = ser
  end

  opts.separator ""
  opts.separator "Operations & Validation:"
  opts.on("--status", "Display overlay cue metadata; does not inspect recording or stream state") do
    options[:status] = true
  end

  opts.on("--list", "List all 37 rewatch episodes and pre-curated Errata entries") do
    options[:list] = true
  end

  opts.on("--preflight", "Run read-only OBS configuration and environment checks") do
    options[:validate] = true
  end

  opts.on("--validate", "Alias for --preflight") do
    options[:validate] = true
  end

  opts.on("--playbook", "Print docs/recording-playbook.md and exit") do
    options[:playbook] = true
  end

  opts.on("--man", "Display comprehensive broadcast operations manual") do
    options[:man] = true
  end

  opts.on_tail("-h", "--help", "Show this help message") do
    puts opts
    exit 0
  end
end

opt_parser.parse!

if options[:man]
  man_path = File.join(ROOT_DIR, "man", "man1", "broadcast.1")
  if File.exist?(man_path)
    system("man #{man_path} 2>/dev/null") || system("cat #{man_path}")
  else
    puts "Manual page available at man/man1/broadcast.1"
  end
  exit 0
end

if options[:playbook]
  playbook_path = File.join(ROOT_DIR, "docs", "recording-playbook.md")
  unless File.file?(playbook_path)
    warn "Recording playbook not found: #{playbook_path}"
    exit 1
  end
  playbook = File.read(playbook_path).sub(/\A---\s*\n.*?\n---\s*\n/m, "")
  puts playbook
  exit 0
end

if options[:validate]
  puts "Running automated broadcast validation..."
  success = system("ruby #{VALIDATOR_SCRIPT}")
  exit(success ? 0 : 1)
end

if options[:list]
  list_curated_catalog
  exit 0
end

if options[:status]
  print_status
  exit 0
end

case options[:archetype]
when "rewatch"
  cue_rewatch(options[:episode] || "unspecified", options)
when "errata"
  cue_errata(options)
when "dialogue"
  cue_dialogue(options)
else
  # If no action specified, print active status
  print_status
  puts ""
  puts "Run 'bin/broadcast --help' for commands, or 'bin/broadcast --list' to view catalog."
end
