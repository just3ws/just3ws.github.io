{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouTubeStagedMetadata",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "transcript_id",
      "youtube_video_id",
      "title",
      "description",
      "chapters",
      "tags",
      "generated_at"
    ],
    "properties": {
      "transcript_id": {
        "type": "string",
        "minLength": 1
      },
      "youtube_video_id": {
        "type": "string",
        "minLength": 5,
        "maxLength": 30
      },
      "title": {
        "type": "string",
        "minLength": 5,
        "maxLength": 100
      },
      "description": {
        "type": "string",
        "minLength": 20
      },
      "chapters": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["time", "title"],
          "properties": {
            "time": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "generated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
